# ==========================================
# 🔐 1. 敏感配置与密钥（绝对不上传）
# ==========================================
config.py
.env
.env.*
*.key
*.pem
*.token
*.token.*
credentials.json
secrets.json

# ==========================================
# 🧠 2. 小橘3号隐私与运行状态（核心拦截）
# ==========================================
# 记忆、身份与权限文件
identity.json
permission.json
stop.flag

# 忽略数据文件夹和所有本地日志
data/
logs/
*.log
*.log.*

# ==========================================
# 🗂️ 3. JSON 文件特殊处理
# ==========================================
# 拦截所有 JSON（防止误传敏感数据），但保留依赖清单
*.json
!requirements.json

# 如果你想保留其他需要上传的JSON（比如公开的配置模板），可以解开下面这行
# !config.example.json

# ==========================================
# 🐍 4. Python 运行时与缓存
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ==========================================
# 📦 5. 打包与构建产物
# ==========================================
build/
dist/
*.egg-info/
xiaoju3_code.tar.gz

# ==========================================
# 📝 6. 开发测试记录
# ==========================================
test.jpg
dev_log_*.md
ALL_LOGS.md

# ==========================================

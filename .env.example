# 小橘3号 · 环境变量模板（复制为 xiaoju3_data/.env 并填入真实值）
# 真实 .env 统一放项目根的 xiaoju3_data/ 隔离区（整目录不入仓库，
# 与 Linux 端一致）。模板本身不含真实值，可以公开。
# 密钥、令牌只保存在本地设备，上传前经 push.sh 四道隐私扫描拦截。

# 云端 DeepSeek 密钥（必填才能使用云端兜底）
DEEPSEEK_API_KEY=

# 本地 Ollama（默认本机；香橙派等主机按需修改）
LOCAL_URL=http://127.0.0.1:11434/api/chat
LOCAL_PROBE_URL=http://127.0.0.1:11434/
LOCAL_MODEL=qwen2.5:7b

# 云端 DeepSeek
CLOUD_URL=https://api.deepseek.com/chat/completions
CLOUD_MODEL=deepseek-chat

# 工作区沙箱根目录（默认项目根下 workspace/）
# WORKSPACE=

# 网页控制台 API Key（POST /chat 的 X-API-Key）
WEB_API_KEY=changeme-xiaoju3

# Home Assistant（心跳与家居控制；不配置则相关功能离线降级）
HA_URL=
HA_TOKEN=

# 安卓视觉点击（可选）——VISION_MODEL 必须使用带 VL 的视觉模型（纯文本模型识别不了截图）
VISION_MODEL=qwen-vl-max-latest
VISION_KEY=
# 视觉模型 API Base URL（新版百炼业务空间 Key 填专属域名；缺省回退 DashScope 旧地址）
VISION_API_URL=

# —— 二阶段新增（各功能模块内读取） ——
# 防死循环熔断阈值：同一工具同参数连续被拒 N 次后剥夺工具调用权（默认 3）
TOOL_FUSE_LIMIT=3
# 本地模型生成超时秒数（区别于 1 秒在线探测；默认 30）
LOCAL_GENERATE_TIMEOUT=30
# 记账本数据路径覆盖（缺省 agent_state/account_book.json）
XIAOJU3_ACCOUNT_BOOK=
# 意图路由模型层开关（默认关；置 1 后规则未命中时让模型参与澄清）
XIAOJU3_MODEL_ROUTE=

# LV4/权限体系：TOTP 动态密码密钥（Base32，用验证器 App 扫 auth_lv4 生成的 otpauth URI）
XIAOJU3_TOTP_SECRET=
# Lv.2 注册密码（/register 用；不配置则注册功能降级提示）
XIAOJU3_REGISTER_PASSWORD=
# 设备守望对端列表（逗号分隔 http://host:port，migration.PeerWatch 用）
XIAOJU3_PEERS=
# 干燥开加湿器场景的湿度阈值（默认 40）
XIAOJU3_HUMIDITY_THRESHOLD=40
# 生物认证模拟开关（仅供测试/演示；置 1 时 /lv4_auth 注册恒真模拟验证器）
XIAOJU3_BIOMETRIC_SIM=
# 多设备守望开关（XIAOJU3_PEERS 非空且置 1 时启动 PeerWatch 守护线程）
XIAOJU3_WATCH=

# —— 硬件自适应路由 ——
# 档位：high（游戏本/满血：本地大模型优先、汇总走本地）| medium（普通本/混合：
# 本地小模型优先、汇总走云端）| low（轻薄本/开发板：跳过本地，云端优先）
# auto（默认）= 启动时经 hardware_profiler 自动探测；推荐先运行
#   python hardware_profiler.py  查看探测报告
DEVICE_TIER=auto
# medium 档使用的本地小模型
LOCAL_MODEL_SMALL=qwen2.5:0.5b





# —— 身份与通知 ——
# 创造者设备声明（仅创造者本人的机器置 1：主人默认称呼才为创造者名）
XIAOJU3_CREATOR_DEVICE=
# 主人 QQ（紧急豁免等重大事件的 QQ 推送目标）
XIAOJU3_OWNER_QQ=

# —— OneBot 11 接入（QQ 收发消息；2026-10-01 已从 NapCat 迁移至 LLOneBot） ——
# LLOneBot 标准正向 HTTP 端口为 3001（NapCat 用户改回 3000 即可）；
# 兼容回退：未配置时读取旧 NAPCAT_API_URL / NAPCAT_TOKEN。
ONEBOT_API_URL=http://127.0.0.1:3001
# OneBot HTTP API 访问令牌（LLOneBot 未开启鉴权时留空）
ONEBOT_TOKEN=
